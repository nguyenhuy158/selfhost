# Postgres. Cặp này dùng 2 chỗ: service `strapi` và service `db`.
STRAPI_DB_USER=strapi
STRAPI_DB_PASSWORD=

# 4 khoá dưới đây đang là GIÁ TRỊ MẪU của Strapi ("your-jwt-secret-here",
# "key1,key2,key3,key4"...) — tức chưa từng được đặt thật. Ai biết mẫu là ký
# được token admin. Sinh lại trước khi mở ra ngoài:
#   openssl rand -base64 32          (cho từng khoá)
#   APP_KEYS cần 4 khoá, nối bằng dấu phẩy.
STRAPI_JWT_SECRET=
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
