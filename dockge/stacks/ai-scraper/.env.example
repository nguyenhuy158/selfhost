# Postgres của ai-scraper. Cùng cặp này xuất hiện 3 chỗ trong compose:
# DATABASE_URL, POSTGRES_USER/PASSWORD, và healthcheck pg_isready.
# Password đang chạy là "huy" — yếu, nên đổi. Đổi rồi phải xoá volume
# postgres_data hoặc ALTER USER, không thì app không login được vào DB.
AISCRAPER_DB_USER=
AISCRAPER_DB_PASSWORD=
