# Mật khẩu đăng nhập UI CronMaster.
#
# Container này chạy `privileged: true` + `user: root` + mount docker.sock và
# sửa được crontab của root, lại publish ra cron.huyab.click. Ai vào được UI là
# chiếm được host. Password đang đặt là "huy" — đổi thành chuỗi dài, ngẫu nhiên.
CRONMASTER_AUTH_PASSWORD=
