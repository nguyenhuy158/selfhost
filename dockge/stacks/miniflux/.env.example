# Postgres. Cặp này dùng 2 chỗ: service `db` và DATABASE_URL của miniflux.
MINIFLUX_DB_USER=miniflux
MINIFLUX_DB_PASSWORD=

# Tài khoản admin, chỉ được tạo ở lần chạy ĐẦU TIÊN (CREATE_ADMIN=1). Sau đó
# đổi ở đây không có tác dụng — phải đổi trong UI hoặc chạy
# `docker exec -it miniflux miniflux -reset-password`.
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=
