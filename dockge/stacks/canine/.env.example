# Bắt buộc — compose khai `${SECRET_KEY_BASE:?...}` nên thiếu là stack không lên.
# Sinh: openssl rand -hex 64
SECRET_KEY_BASE=

# Postgres. Cùng cặp này dùng ở 3 chỗ: DATABASE_URL, POSTGRES_USER/PASSWORD,
# healthcheck pg_isready. Password đang chạy là "password" — yếu, nên đổi.
CANINE_DB_USER=postgres
CANINE_DB_PASSWORD=
