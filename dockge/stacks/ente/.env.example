# Postgres của museum. Đổi password sau khi đã có data thì phải đổi luôn trong
# museum.yaml, không thì museum không kết nối được.
ENTE_POSTGRES_USER=pguser
ENTE_POSTGRES_PASSWORD=

# MinIO làm object storage. Cùng cặp này còn được dùng lại ở post_start
# (`mc alias set`), nên sửa một chỗ là đủ.
ENTE_MINIO_ROOT_USER=minio-user-xxxxxxxx
ENTE_MINIO_ROOT_PASSWORD=
