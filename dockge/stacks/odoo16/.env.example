# Postgres của Odoo. Cặp này dùng 2 chỗ: service `db` (POSTGRES_USER/PASSWORD)
# và service `odoo16` (USER/PASSWORD) — hai bên phải khớp.
#
# Đổi password khi đã có data thì phải ALTER USER trong postgres, không thì
# Odoo không kết nối được. `./etc` cũng có thể chứa odoo.conf ghi lại password.
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=
