# Netdata Cloud claim — lấy ở https://app.netdata.cloud, phần "Connect Nodes".
#
# Stack `ansible/ansible` cũng có một netdata y hệt, dùng CHUNG token này và
# trùng container_name "netdata". Hai stack không chạy cùng lúc được.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_URL=https://app.netdata.cloud
NETDATA_CLAIM_ROOMS=
