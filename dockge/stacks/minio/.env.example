# MinIO console + API. Giá trị đang chạy là "adminadminadmin" cho cả user lẫn
# password — yếu, nên đổi.
#
# File .env cũ viết sai cú pháp (`KEY: value` kiểu YAML). docker compose đọc
# .env theo dạng KEY=value, dòng có dấu hai chấm bị bỏ qua im lặng, nên biến
# không bao giờ được nạp. Luôn dùng dấu `=`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
